# ClayBank local environment
#
# Copy to `.env` for local development. `.env` is ignored and must never be
# committed. `.env.example` documents every supported variable.
#
# Rules:
# - Secrets live only in process environment or local `.env`.
# - Tests never read `.env`; they use explicit mocks and in-memory fixtures.
# - Cloud providers must not use a training-on-user-data tier.

# Development bearer token accepted by the FastAPI MVP middleware.
DEV_TOKEN=dev-token

# Stable identifier for the local development device.
X_DEVICE_ID=dev-laptop

# SQLite database used by local backend startup.
CLAYBANK_DB_PATH=data/claybank.sqlite3

# Transcription uses the multimodal cloud model only. There is no separate
# audio STT provider and no local Whisper fallback. The same Meta endpoint
# below provides transcription and visual description.

# Cloud note/chat provider. Empty means deterministic local answer synthesis.
# OpenAI-compatible endpoint, key, and model for Meta Model API-compatible use.
# The same endpoint may provide multimodal transcription and visual description.
# Production model: muse-spark-1.2. Development/testing model: 1.2-contributor.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_KEY=
META_MODEL_API_MODEL=muse-spark-1.2-contributor
META_MODEL_CONTRIBUTOR_TIER=false

# Optional local models. Empty means local inference is unavailable.
LOCAL_CHAT_MODEL_ID=
LOCAL_CHAT_MODEL_PATH=

# Browser-rendered extraction fallback. False by default.
CRAWL4AI_ENABLED=false
DEEP_CRAWL_ENABLED=false
