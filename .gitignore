.playwright-mcp/

# Private decision logs (kept locally, not published)
Docs/Memory.md
Docs/adr/

# Scratch notes (kept locally, not published)
TempDocs/

# Local runtime data: dev SQLite DB is rebuilt from Docs/db/*.sql on startup
Backend/data/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local embedding model weights (downloaded via Backend/store/embeddings.py;
# ~1.3 GB with quantized variants — never commit binaries or HF caches)
Backend/models/multilingual-e5-small/*
!Backend/models/.gitkeep
*.onnx
**/.cache/huggingface/

# Local secrets / env overrides
.env
.env.*
!.env.example

# Flet build outputs (ADR 0001: app/ is the Flet shell, built with `flet build`)
app/build/
*.apk
*.aab

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db