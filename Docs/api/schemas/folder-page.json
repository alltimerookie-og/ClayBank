{
  "$id": "folder-page.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FolderPage",
  "description": "Envelope for GET /folders (cursor pagination).",
  "type": "object",
  "required": ["items", "cursor"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "folder.json" } },
    "cursor": { "type": ["string", "null"] }
  }
}
