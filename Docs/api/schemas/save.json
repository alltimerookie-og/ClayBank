{
  "$id": "save.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Save",
  "description": "One captured link. Capture is durable; kind starts as `unknown` until the pipeline classifies it.",
  "type": "object",
  "required": ["id", "url", "platform", "source_app", "captured_at", "user_context", "kind", "needs_review"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "url": { "type": "string", "format": "uri", "description": "Canonicalized capture-time URL (tracking stripped, /shorts / watch resolved)." },
    "raw_url": { "type": "string", "format": "uri", "description": "As captured, for provenance." },
    "platform": { "type": "string", "description": "Derived from URL host by the server. Never user-supplied." },
    "source_app": { "type": "string", "description": "Client-sent sharing app (e.g. `instagram`). Free-form, lowercased." },
    "user_context": { "type": "string", "description": "User's save-time note (`why do you want this?`)." },
    "kind": {
      "type": "string",
      "enum": ["video", "article", "unknown"],
      "description": "Pipeline + template selector. Never an organizing axis in the UI."
    },
    "has_audio": { "type": "boolean", "default": false },
    "has_timeline": { "type": "boolean", "default": false },
    "has_images": { "type": "boolean", "default": false },
    "duration": { "type": ["integer", "null"], "minimum": 0 },
    "title": { "type": ["string", "null"] },
    "needs_review": { "type": "boolean", "description": "Derived: suggestion below threshold or conflict. Powering the review queue filter." },
    "folder_id": { "type": ["string", "null"], "format": "uuid", "description": "Nullable = Inbox-as-state. Zero or one folder per save." },
    "suggested_folder": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string", "description": "Slash path like `Cooking / Pasta`." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "captured_by_device": { "type": ["string", "null"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
