{
  "$id": "extraction-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractionResult",
  "description": "Schema both tiers must emit: tier 1 (yt-dlp / trafilatura) always; tier 2 (agent rescue) only when a kind's required fields are ALL absent — video: no title AND no transcript; article: no body; unknown: no title AND no body. Tier 2 caps: 5 tool calls / 45 s; it degrades to `unknown` rather than partial-writing (ADR 0002).",
  "type": "object",
  "required": ["tier", "kind"],
  "properties": {
    "tier": { "type": "integer", "enum": [1, 2] },
    "kind": { "type": "string", "enum": ["video", "article", "unknown"] },
    "title": { "type": ["string", "null"] },
    "channel": { "type": ["string", "null"] },
    "duration": { "type": ["integer", "null"], "minimum": 0 },
    "published": { "type": ["string", "null"], "format": "date" },
    "body": { "type": ["string", "null"], "description": "Article body text / video transcript-from-captions." },
    "transcript_available": { "type": "boolean", "default": false },
    "capability_flags": {
      "type": "object",
      "properties": {
        "has_audio": { "type": "boolean", "default": false },
        "has_timeline": { "type": "boolean", "default": false },
        "has_images": { "type": "boolean", "default": false }
      }
    },
    "source_meta": {
      "type": "object",
      "description": "Platform-specific extras (e.g. channel_id, thumbnail URL). Informational; excluded from note frontmatter facts."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "video" } } },
      "then": { "properties": { "has_audio": { "const": true } } }
    }
  ]
}
