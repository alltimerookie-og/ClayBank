{
  "$id": "tag.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tag",
  "description": "A flat label, many per save. Not a container; no hierarchy; case-insensitively unique.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "id": { "type": ["string", "null"], "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "save_count": { "type": "integer" }
  }
}
